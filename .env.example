# Demo fallback mode: when true, all external APIs return deterministic mock data
MOCK_MODE=true

# Application ports & URLs
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# External API keys (leave blank when MOCK_MODE=true)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optibook Exchange connection (optional inside Optiver Dev Environment)
# OPTIBOOK_HOST=
# OPTIBOOK_INFO_PORT=
# OPTIBOOK_EXEC_PORT=
# OPTIBOOK_USERNAME=
# OPTIBOOK_PASSWORD=
