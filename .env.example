# Demo fallback mode: when true, all external APIs return deterministic mock data
MOCK_MODE=true

# Application ports & URLs
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# External API keys (leave blank when MOCK_MODE=true)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optibook Exchange connection (optional inside Optiver Dev Environment)
# OPTIBOOK_HOST=
# OPTIBOOK_INFO_PORT=
# OPTIBOOK_EXEC_PORT=
# OPTIBOOK_USERNAME=
# OPTIBOOK_PASSWORD=

# Pure ABMM-S risk & Fair-Value tuning (normal 2-day continuous mode, endgame off)
# SESSION_DURATION_SEC=0
# MAX_POSITION_LOTS=40
# MAX_NET_PORTFOLIO_LOTS=120
# MAX_SESSION_DRAWDOWN=500.0
# ABMMS_WALL_MIN_VOL=250
# ABMMS_GLFT_GAMMA=6.0
# TAIL_STOP_TICKS=10.0
# ENABLE_EDGE_IOC=true
# ENABLE_NEWS_SNIPER=true
# NEWS_SNIPE_LOTS=5
